      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('ok is true', () => pm.expect(pm.response.json()).to.eql({ok: true}));"
            ]
          }
        }
      ]
    }
  ]
}
