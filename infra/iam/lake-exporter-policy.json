{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteChatlogPartitionsAndReports",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::YOUR-BUCKET/chatlogs/*",
        "arn:aws:s3:::YOUR-BUCKET/reports/*"
      ],
      "Condition": {"StringEquals": {"s3:x-amz-server-side-encryption": "AES256"}}
    }
  ]
}
